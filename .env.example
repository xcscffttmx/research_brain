### Qwen / DashScope（必填）
QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3
# Agentic RAG 精排模型（gte-rerank 已下线，使用 v2）
QWEN_RERANK_MODEL=gte-rerank-v2
# 精排接口地址，默认由 QWEN_BASE_URL 推导为原生 text-rerank 路径，一般无需填写
# QWEN_RERANK_URL=

### 文献检索（可选，配置后可提升 Semantic Scholar 配额）
SEMANTIC_SCHOLAR_API_KEY=

### 服务端
SERVER_PORT=8788
# 允许的跨域来源，多个用逗号分隔；留空则只允许同源
ALLOWED_ORIGINS=http://localhost:5173

### SQLite（可选，默认 .data/research-agent.db；测试可设为 :memory:）
SQLITE_PATH=

### Context 预算（可选）
# 模型上下文上限，用于 Token Budget 计算
CONTEXT_MAX_TOKENS=32000
