{
  "name": "qwen-agent-chat",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node ./server/index.js",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "db:migrate": "node ./server/db/migrate.js",
    "db:verify": "node ./server/db/verifySqliteVec.js",
    "db:smoke": "node ./server/db/smokeTest.js",
    "lint": "echo \"lint script placeholder — configured in S8\" && exit 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "echo \"format script placeholder — configured in S8\" && exit 0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dompurify": "^3.2.6",
    "dotenv": "^16.6.1",
    "element-plus": "^2.9.11",
    "express": "^4.21.2",
    "gpt-tokenizer": "^2.9.0",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.1.0",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "pinia": "^3.0.3",
    "sqlite-vec": "^0.1.7-alpha.2",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "^2.0.0-beta.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.1.4",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "unplugin-auto-import": "^19.1.2",
    "unplugin-vue-components": "^28.5.0",
    "vite": "^6.0.7",
    "vitest": "^3.1.4",
    "vue-tsc": "^2.2.0"
  }
}
